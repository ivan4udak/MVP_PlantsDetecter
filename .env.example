# ============================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# Скопируй: cp .env.example .env
# Заполни все CHANGE_ME значения
# НИКОГДА не коммить .env в git!
# ============================================

DB_NAME=plant_identifier_db
DB_USER=plant_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Минимум 64 символа, только A-Z a-z 0-9 - _
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_SECRET_KEY
JWT_EXPIRATION=86400000

SPRING_PROFILE=dev

PGADMIN_EMAIL=admin@plant.dev
PGADMIN_PASSWORD=CHANGE_ME